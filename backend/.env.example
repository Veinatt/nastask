PORT=5000
DATABASE_PATH=./data/nastask.sqlite
AUTH_DEV_BYPASS=true
BOT_TOKEN=
# Opt-in outbound bot (polling + reminders). Default off — token alone does not message anyone.
BOT_ENABLED=false
INIT_DATA_MAX_AGE_SEC=86400
# Optional: public URL for Telegram file downloads (defaults to request host)
PUBLIC_API_URL=
